datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                   String    @id @default(uuid())
  fullName             String
  email                String    @unique
  phone                String?
  passwordHash         String
  avatarUrl            String?
  role                 String    @default("ADMIN") // For fallback/compatibility
  isActive             Boolean   @default(true)
  isSystemAdmin        Boolean   @default(false)
  twoFactorEnabled     Boolean   @default(false)
  twoFactorSecret      String?
  twoFactorActivatedAt DateTime?
  lastLoginAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  createdBy            String?
  updatedBy            String?

  userRoles        UserRole[]
  userBranches     UserBranch[]
  auditLogs        AuditLog[]
  paymentRequests  PaymentRequest[] @relation("Requester")
  approvedRequests PaymentRequest[] @relation("Approver")
  createdVouchers  PaymentVoucher[] @relation("VoucherCreator")

  @@map("Users")
}

model Branch {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  address     String?  @db.NVarChar(MAX)
  phone       String?
  email       String?
  managerName String?
  openingTime String?
  closingTime String?
  status      String   @default("ACTIVE")
  latitude    Decimal? @db.Decimal(18, 8)
  longitude   Decimal? @db.Decimal(18, 8)
  taxCode     String?
  invoiceName String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userBranches      UserBranch[]
  customers         Customer[]                 @relation("CustomerRegisteredBranch")
  payrollEmployees  PayrollEmployee[]
  pointTransactions CustomerPointTransaction[]
  vouchers          VoucherBranch[]
  customerVouchers  CustomerVoucher[]

  @@map("Branches")
}

model UserBranch {
  id        String   @id @default(uuid())
  userId    String
  branchId  String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@map("UserBranches")
}

model SiteSettings {
  id             String  @id @default(uuid())
  siteName       String
  slogan         String?
  primaryColor   String  @default("#4A250F")
  secondaryColor String  @default("#C96A24")
  accentColor    String  @default("#D99A2B")
  phone          String?
  email          String?
  address        String?
  facebookUrl    String?
  zaloUrl        String?
  googleMapUrl   String? @db.NVarChar(MAX)
  openingHours   String?
  seoTitle       String?
  seoDescription String? @db.NVarChar(MAX)
  seoKeywords    String? @db.NVarChar(MAX)
  faviconUrl     String?
  logoUrl        String?

  @@map("SiteSettings")
}

model Banner {
  id           String   @id @default(uuid())
  title        String
  subtitle     String?
  description  String?  @db.NVarChar(MAX)
  imageUrl     String
  buttonText   String?
  buttonLink   String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@map("Banners")
}

model NavigationItem {
  id           String   @id @default(uuid())
  label        String
  url          String
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@map("NavigationItems")
}

model HomeSection {
  id           String   @id @default(uuid())
  sectionKey   String   @unique
  title        String
  subtitle     String?
  description  String?  @db.NVarChar(MAX)
  imageUrl     String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@map("HomeSections")
}

model MenuCategory {
  id           String     @id @default(uuid())
  name         String
  description  String?    @db.NVarChar(MAX)
  displayOrder Int        @default(0)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  menuItems    MenuItem[]

  @@map("MenuCategories")
}

model MenuItem {
  id               String       @id @default(uuid())
  categoryId       String
  name             String
  slug             String       @unique
  imageUrl         String
  price            Decimal      @db.Decimal(18, 2)
  salePrice        Decimal?     @db.Decimal(18, 2)
  shortDescription String?      @db.NVarChar(MAX)
  description      String?      @db.NVarChar(MAX)
  ingredients      String?      @db.NVarChar(MAX)
  isFeatured       Boolean      @default(false)
  isAvailable      Boolean      @default(true)
  displayOrder     Int          @default(0)
  createdAt        DateTime     @default(now())
  category         MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("MenuItems")
}

model Promotion {
  id           String   @id @default(uuid())
  title        String
  description  String?  @db.NVarChar(MAX)
  imageUrl     String
  startDate    DateTime
  endDate      DateTime
  discountText String?
  buttonText   String?
  buttonLink   String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@map("Promotions")
}

model GalleryImage {
  id           String   @id @default(uuid())
  title        String?
  imageUrl     String
  altText      String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@map("GalleryImages")
}

model Testimonial {
  id           String   @id @default(uuid())
  customerName String
  content      String   @db.NVarChar(MAX)
  rating       Int      @default(5)
  avatarUrl    String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@map("Testimonials")
}

model ContactMessage {
  id        String   @id @default(uuid())
  fullName  String
  phone     String
  email     String?
  message   String   @db.NVarChar(MAX)
  status    String   @default("NEW") // NEW, CONTACTED, DONE
  createdAt DateTime @default(now())

  @@map("ContactMessages")
}

model MediaFile {
  id           String   @id @default(uuid())
  fileName     String
  originalName String
  fileUrl      String
  mimeType     String
  size         Int
  altText      String?  @db.NVarChar(MAX)
  title        String?  @db.NVarChar(MAX)
  caption      String?  @db.NVarChar(MAX)
  createdAt    DateTime @default(now())

  @@map("MediaFiles")
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  action       String
  entity       String?
  entityName   String?
  entityId     String?
  oldValue     String?  @db.NVarChar(MAX)
  newValue     String?  @db.NVarChar(MAX)
  oldValueJson String?  @db.NVarChar(MAX)
  newValueJson String?  @db.NVarChar(MAX)
  ipAddress    String?
  userAgent    String?  @db.NVarChar(MAX)
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("AuditLogs")
}

model BlogCategory {
  id           String     @id @default(uuid())
  name         String
  slug         String     @unique
  description  String?    @db.NVarChar(MAX)
  displayOrder Int        @default(0)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  posts        BlogPost[]

  @@map("BlogCategories")
}

model BlogPost {
  id             String       @id @default(uuid())
  categoryId     String
  title          String
  slug           String       @unique
  excerpt        String?      @db.NVarChar(MAX)
  content        String       @db.NVarChar(MAX)
  thumbnailUrl   String?
  coverImageUrl  String?
  authorName     String?
  status         String       @default("DRAFT")
  publishedAt    DateTime?
  readingTime    Int          @default(1)
  tags           String?      @db.NVarChar(MAX)
  seoTitle       String?
  seoDescription String?      @db.NVarChar(MAX)
  seoKeywords    String?      @db.NVarChar(MAX)
  canonicalUrl   String?
  ogTitle        String?
  ogDescription  String?      @db.NVarChar(MAX)
  ogImageUrl     String?
  schemaType     String       @default("BlogPosting")
  viewCount      Int          @default(0)
  isFeatured     Boolean      @default(false)
  displayOrder   Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  category       BlogCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@index([status])
  @@index([publishedAt])
  @@map("BlogPosts")
}

model SeoPage {
  id             String   @id @default(uuid())
  title          String
  slug           String   @unique
  excerpt        String?  @db.NVarChar(MAX)
  content        String   @db.NVarChar(MAX)
  coverImageUrl  String?
  seoTitle       String?
  seoDescription String?  @db.NVarChar(MAX)
  seoKeywords    String?  @db.NVarChar(MAX)
  canonicalUrl   String?
  ogTitle        String?
  ogDescription  String?  @db.NVarChar(MAX)
  ogImageUrl     String?
  schemaType     String   @default("Article")
  isPublished    Boolean  @default(true)
  displayOrder   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("SeoPages")
}

model FAQ {
  id           String   @id @default(uuid())
  question     String   @db.NVarChar(MAX)
  answer       String   @db.NVarChar(MAX)
  pageSlug     String?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  @@map("FAQs")
}

model CustomerReview {
  id           String   @id @default(uuid())
  customerName String
  rating       Int      @default(5)
  content      String   @db.NVarChar(MAX)
  avatar       String?
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@map("CustomerReviews")
}

model Customer {
  id                 String    @id @default(uuid())
  code               String    @unique
  fullName           String
  phone              String?
  email              String?
  birthday           DateTime?
  gender             String?
  tierId             String?
  registeredBranchId String?
  status             String    @default("ACTIVE")
  currentPoints      Int       @default(0)
  totalOrders        Int       @default(0)
  totalSpent         Decimal   @default(0.0) @db.Decimal(18, 2)
  lastOrderAt        DateTime?
  note               String?   @db.NVarChar(MAX)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tier             MembershipTier?            @relation(fields: [tierId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  registeredBranch Branch?                    @relation("CustomerRegisteredBranch", fields: [registeredBranchId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  points           CustomerPointTransaction[]
  vouchers         CustomerVoucher[]
  notes            CustomerNote[]

  @@index([phone])
  @@index([registeredBranchId])
  @@map("Customers")
}

model CustomerNote {
  id         String   @id @default(uuid())
  customerId String
  note       String   @db.NVarChar(MAX)
  createdBy  String?
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@map("CustomerNotes")
}

model MembershipTier {
  id              String   @id @default(uuid())
  code            String   @unique
  name            String
  minSpent        Decimal  @default(0.0) @db.Decimal(18, 2)
  minPoints       Int      @default(0)
  discountPercent Decimal  @default(0.0) @db.Decimal(5, 2)
  description     String?  @db.NVarChar(MAX)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customers Customer[]
  vouchers  Voucher[]

  @@map("MembershipTiers")
}

model LoyaltySetting {
  id               String   @id @default(uuid())
  code             String   @unique @default("DEFAULT")
  pointsPerAmount  Decimal  @default(1000.0) @db.Decimal(18, 2)
  pointsEarned     Int      @default(1)
  minOrderAmount   Decimal  @default(0.0) @db.Decimal(18, 2)
  maxRedeemPercent Decimal  @default(30.0) @db.Decimal(5, 2)
  pointValueAmount Decimal  @default(1000.0) @db.Decimal(18, 2)
  pointExpiryDays  Int?
  isActive         Boolean  @default(true)
  updatedAt        DateTime @updatedAt

  @@map("LoyaltySettings")
}

model FaceRecognitionSetting {
  id                     String   @id @default(uuid())
  code                   String   @unique @default("DEFAULT")
  provider               String   @default("EXTERNAL")
  apiUrl                 String?  @db.NVarChar(MAX)
  apiKey                 String?  @db.NVarChar(MAX)
  threshold              Decimal  @default(0.75) @db.Decimal(8, 6)
  duplicateWindowSeconds Int      @default(10)
  isActive               Boolean  @default(true)
  lastHealthStatus       String?
  lastHealthMessage      String?  @db.NVarChar(MAX)
  lastHealthCheckedAt    DateTime?
  updatedAt              DateTime @updatedAt

  @@map("FaceRecognitionSettings")
}

model CustomerPointTransaction {
  id          String    @id @default(uuid())
  customerId  String
  branchId    String?
  type        String
  points      Int
  amount      Decimal   @default(0.0) @db.Decimal(18, 2)
  orderNo     String?
  referenceId String?
  note        String?   @db.NVarChar(MAX)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  createdBy   String?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branch   Branch?  @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([customerId, createdAt])
  @@index([branchId, createdAt])
  @@map("CustomerPointTransactions")
}

model Voucher {
  id             String    @id @default(uuid())
  code           String    @unique
  name           String
  description    String?   @db.NVarChar(MAX)
  discountType   String    @default("AMOUNT")
  discountValue  Decimal   @default(0.0) @db.Decimal(18, 2)
  minOrderAmount Decimal   @default(0.0) @db.Decimal(18, 2)
  maxDiscount    Decimal?  @db.Decimal(18, 2)
  pointsCost     Int       @default(0)
  scope          String    @default("ALL_BRANCHES")
  tierId         String?
  startAt        DateTime?
  endAt          DateTime?
  usageLimit     Int?
  usedCount      Int       @default(0)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tier      MembershipTier?   @relation(fields: [tierId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  branches  VoucherBranch[]
  customers CustomerVoucher[]

  @@index([scope, isActive])
  @@map("Vouchers")
}

model VoucherBranch {
  id        String @id @default(uuid())
  voucherId String
  branchId  String

  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([voucherId, branchId])
  @@map("VoucherBranches")
}

model CustomerVoucher {
  id         String    @id @default(uuid())
  customerId String
  voucherId  String
  branchId   String?
  status     String    @default("ISSUED")
  assignedAt DateTime  @default(now())
  usedAt     DateTime?
  orderNo    String?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  voucher  Voucher  @relation(fields: [voucherId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branch   Branch?  @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([customerId, status])
  @@map("CustomerVouchers")
}

// User role management tables
model Role {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  description  String?  @db.NVarChar(MAX)
  isSystemRole Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("Roles")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("UserRoles")
}

model Menu {
  id        String  @id @default(uuid())
  code      String  @unique
  name      String
  path      String?
  icon      String?
  parentId  String?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)
  isVisible Boolean @default(true)

  parent          Menu?            @relation("MenuToMenu", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children        Menu[]           @relation("MenuToMenu")
  rolePermissions RolePermission[]

  @@map("Menus")
}

model Permission {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  description String? @db.NVarChar(MAX)

  rolePermissions RolePermission[]

  @@map("Permissions")
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String
  menuId       String
  permissionId String
  isAllowed    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  menu       Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, menuId, permissionId])
  @@map("RolePermissions")
}

// Payment/Expense management tables
model ExpenseCategory {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  group     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  paymentRequests PaymentRequest[]
  paymentVouchers PaymentVoucher[]

  @@map("ExpenseCategories")
}

model PaymentMethod {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  paymentVouchers PaymentVoucher[]

  @@map("PaymentMethods")
}

model CashAccount {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  balance   Decimal  @default(0.0) @db.Decimal(18, 2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  paymentVouchers PaymentVoucher[]

  @@map("CashAccounts")
}

model Supplier {
  id                 String    @id @default(uuid())
  name               String
  contactName        String?
  phone              String?
  taxCode            String?
  address            String?
  bankName           String?
  bankAccountNo      String?
  bankAccountName    String?
  currentDebt        Decimal   @default(0.0) @db.Decimal(18, 2)
  paymentTerm        String?
  paymentTermDays    Int?
  paymentDueDate     DateTime?
  paymentWarningDays Int       @default(3)
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  paymentRequests PaymentRequest[]
  paymentVouchers PaymentVoucher[]
  debtNotes       SupplierDebtNote[]

  @@map("Suppliers")
}

model SupplierDebtNote {
  id              String    @id @default(uuid())
  code            String    @unique
  supplierId      String
  debtDate        DateTime
  dueDate         DateTime?
  title           String
  description     String?   @db.NVarChar(MAX)
  amount          Decimal   @db.Decimal(18, 2)
  paidAmount      Decimal   @default(0.0) @db.Decimal(18, 2)
  remainingAmount Decimal   @default(0.0) @db.Decimal(18, 2)
  status          String    @default("UNPAID") // UNPAID, PARTIAL, PAID, CANCELLED
  attachmentUrl   String?   @db.NVarChar(MAX)
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  supplier        Supplier         @relation(fields: [supplierId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  paymentVouchers PaymentVoucher[]

  @@index([supplierId, debtDate])
  @@index([dueDate, status])
  @@map("SupplierDebtNotes")
}

model PaymentRequest {
  id                String    @id @default(uuid())
  code              String    @unique
  requestDate       DateTime  @default(now())
  requesterId       String
  department        String
  expenseCategoryId String
  supplierId        String?
  amount            Decimal   @db.Decimal(18, 2)
  reason            String    @db.NVarChar(MAX)
  attachmentUrl     String?   @db.NVarChar(MAX)
  status            String    @default("PENDING") // DRAFT, PENDING, APPROVED, REJECTED, PAID, CANCELLED
  approvedById      String?
  approvedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  requester       User             @relation("Requester", fields: [requesterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approver        User?            @relation("Approver", fields: [approvedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  expenseCategory ExpenseCategory  @relation(fields: [expenseCategoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  supplier        Supplier?        @relation(fields: [supplierId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  paymentVouchers PaymentVoucher[]

  @@map("PaymentRequests")
}

model PaymentVoucher {
  id                String   @id @default(uuid())
  code              String   @unique
  paymentDate       DateTime @default(now())
  paymentRequestId  String?
  supplierId        String?
  supplierDebtId    String?
  recipientName     String
  reason            String   @db.NVarChar(MAX)
  amount            Decimal  @db.Decimal(18, 2)
  paymentMethodId   String
  cashAccountId     String
  expenseCategoryId String
  attachmentUrl     String?  @db.NVarChar(MAX)
  notes             String?  @db.NVarChar(MAX)
  status            String   @default("UNPOSTED") // UNPOSTED, POSTED (đối soát/ghi sổ)
  createdById       String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  paymentRequest  PaymentRequest?   @relation(fields: [paymentRequestId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  supplier        Supplier?         @relation(fields: [supplierId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  supplierDebt    SupplierDebtNote? @relation(fields: [supplierDebtId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  paymentMethod   PaymentMethod     @relation(fields: [paymentMethodId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cashAccount     CashAccount       @relation(fields: [cashAccountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  expenseCategory ExpenseCategory   @relation(fields: [expenseCategoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  creator         User              @relation("VoucherCreator", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("PaymentVouchers")
}

// Attendance and payroll management tables
model WorkShift {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  startTime   String?
  endTime     String?
  hourlyRate  Decimal  @default(0.0) @db.Decimal(18, 2)
  description String?  @db.NVarChar(MAX)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees   PayrollEmployee[]
  attendances AttendanceRecord[]

  @@map("WorkShifts")
}

model PayrollEmployee {
  id               String    @id @default(uuid())
  code             String    @unique
  fullName         String
  phone            String?
  department       String?
  position         String?
  avatarUrl        String?
  branchId         String?
  defaultShiftId   String?
  hourlyRate       Decimal?  @db.Decimal(18, 2)
  faceStatus       String    @default("NOT_REGISTERED")
  faceRegisteredAt DateTime?
  note             String?   @db.NVarChar(MAX)
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  branch            Branch?                    @relation(fields: [branchId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  defaultShift      WorkShift?                 @relation(fields: [defaultShiftId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  attendances       AttendanceRecord[]
  payrollLines      PayrollLine[]
  kpiRecords        EmployeeKpiRecord[]
  adjustments       EmployeeRewardPenalty[]
  faceRegistrations EmployeeFaceRegistration[]
  faceImages        EmployeeFaceImage[]

  @@map("PayrollEmployees")
}

model AttendanceRecord {
  id                    String    @id @default(uuid())
  employeeId            String
  shiftId               String?
  workDate              DateTime
  clockIn               DateTime
  clockOut              DateTime?
  breakMinutes          Int       @default(0)
  hourlyRate            Decimal   @default(0.0) @db.Decimal(18, 2)
  totalHours            Decimal   @default(0.0) @db.Decimal(10, 2)
  grossAmount           Decimal   @default(0.0) @db.Decimal(18, 2)
  note                  String?   @db.NVarChar(MAX)
  status                String    @default("RECORDED")
  faceCapturedImageUrl  String?   @db.NVarChar(MAX)
  faceImageKitFileId    String?
  recognitionStatus     String?
  recognitionConfidence Decimal?  @db.Decimal(8, 6)
  recognitionDeviceId   String?
  recognitionLocationId String?
  recognizedAt          DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  employee PayrollEmployee @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  shift    WorkShift?      @relation(fields: [shiftId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([workDate])
  @@index([employeeId, workDate])
  @@map("AttendanceRecords")
}

model EmployeeFaceRegistration {
  id           String   @id @default(uuid())
  employeeId   String
  employeeCode String
  status       String   @default("REGISTERED")
  registeredAt DateTime @default(now())
  registeredBy String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  isActive     Boolean  @default(true)

  employee PayrollEmployee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  images   EmployeeFaceImage[]

  @@index([employeeId, isActive])
  @@map("EmployeeFaceRegistrations")
}

model EmployeeFaceImage {
  id                 String   @id @default(uuid())
  faceRegistrationId String
  employeeId         String
  pose               String
  imageUrl           String   @db.NVarChar(MAX)
  imageKitFileId     String?
  faceDetected       Boolean  @default(false)
  faceCount          Int      @default(0)
  embedding          String?  @db.NVarChar(MAX)
  embeddingVersion   String?
  createdAt          DateTime @default(now())
  isActive           Boolean  @default(true)

  registration EmployeeFaceRegistration @relation(fields: [faceRegistrationId], references: [id], onDelete: Cascade)
  employee     PayrollEmployee          @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([faceRegistrationId, pose])
  @@index([employeeId, pose])
  @@map("EmployeeFaceImages")
}

model PayrollRun {
  id             String   @id @default(uuid())
  code           String   @unique
  periodStart    DateTime
  periodEnd      DateTime
  status         String   @default("DRAFT")
  totalHours     Decimal  @default(0.0) @db.Decimal(18, 2)
  totalAmount    Decimal  @default(0.0) @db.Decimal(18, 2)
  totalKpiReward Decimal  @default(0.0) @db.Decimal(18, 2)
  totalBonus     Decimal  @default(0.0) @db.Decimal(18, 2)
  totalPenalty   Decimal  @default(0.0) @db.Decimal(18, 2)
  netAmount      Decimal  @default(0.0) @db.Decimal(18, 2)
  note           String?  @db.NVarChar(MAX)
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lines PayrollLine[]

  @@index([periodStart, periodEnd])
  @@map("PayrollRuns")
}

model PayrollLine {
  id              String   @id @default(uuid())
  payrollRunId    String
  employeeId      String
  employeeCode    String
  employeeName    String
  position        String?
  shiftName       String?
  attendanceCount Int      @default(0)
  totalHours      Decimal  @default(0.0) @db.Decimal(18, 2)
  hourlyRate      Decimal  @default(0.0) @db.Decimal(18, 2)
  grossAmount     Decimal  @default(0.0) @db.Decimal(18, 2)
  kpiScore        Decimal? @db.Decimal(10, 2)
  kpiLevelName    String?
  kpiRewardAmount Decimal  @default(0.0) @db.Decimal(18, 2)
  bonusAmount     Decimal  @default(0.0) @db.Decimal(18, 2)
  penaltyAmount   Decimal  @default(0.0) @db.Decimal(18, 2)
  netAmount       Decimal  @default(0.0) @db.Decimal(18, 2)
  note            String?  @db.NVarChar(MAX)

  payrollRun PayrollRun      @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee   PayrollEmployee @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([payrollRunId, employeeId])
  @@map("PayrollLines")
}

model KpiLevel {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  minScore     Decimal  @default(0.0) @db.Decimal(10, 2)
  maxScore     Decimal? @db.Decimal(10, 2)
  rewardAmount Decimal  @default(0.0) @db.Decimal(18, 2)
  description  String?  @db.NVarChar(MAX)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  records EmployeeKpiRecord[]

  @@map("KpiLevels")
}

model EmployeeKpiRecord {
  id           String   @id @default(uuid())
  employeeId   String
  periodStart  DateTime
  periodEnd    DateTime
  score        Decimal  @default(0.0) @db.Decimal(10, 2)
  levelId      String?
  rewardAmount Decimal  @default(0.0) @db.Decimal(18, 2)
  note         String?  @db.NVarChar(MAX)
  status       String   @default("APPROVED") // DRAFT, APPROVED, APPLIED, CANCELLED
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employee PayrollEmployee @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  level    KpiLevel?       @relation(fields: [levelId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([employeeId, periodStart, periodEnd])
  @@map("EmployeeKpiRecords")
}

model RewardPenaltyCategory {
  id            String   @id @default(uuid())
  code          String   @unique
  name          String
  type          String   @default("BONUS") // BONUS, PENALTY
  severity      String? // INFO, WARNING, MINOR, MAJOR, CRITICAL
  defaultAmount Decimal  @default(0.0) @db.Decimal(18, 2)
  description   String?  @db.NVarChar(MAX)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  adjustments EmployeeRewardPenalty[]

  @@map("RewardPenaltyCategories")
}

model EmployeeRewardPenalty {
  id           String    @id @default(uuid())
  employeeId   String
  categoryId   String?
  type         String    @default("BONUS") // BONUS, PENALTY
  severity     String?
  incidentDate DateTime
  amount       Decimal   @default(0.0) @db.Decimal(18, 2)
  reason       String    @db.NVarChar(MAX)
  status       String    @default("PENDING") // PENDING, APPLIED, CANCELLED
  appliedAt    DateTime?
  note         String?   @db.NVarChar(MAX)
  createdBy    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  employee PayrollEmployee        @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  category RewardPenaltyCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([employeeId, incidentDate])
  @@index([type, status])
  @@map("EmployeeRewardPenalties")
}
